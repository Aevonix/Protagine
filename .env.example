# Protagine Sidecar - Example Configuration
# Copy to ~/.protagine/.env and fill in your values.
#
# NOTE: Protagine does NOT need LLM keys here. The host (Hermes, an MCP client,
# or anything speaking the REST API) provides LLM credentials at runtime via
# POST /v1/host/configure, and they are persisted in the state dir.
#
# `protagine init` writes most of this for you. `protagine doctor` validates it.

# =============================================================================
# CORE
# =============================================================================

# Bind address — use 0.0.0.0 for remote agent connections
# PROTAGINE_SIDECAR_HOST=0.0.0.0
PROTAGINE_SIDECAR_HOST=127.0.0.1
PROTAGINE_SIDECAR_PORT=7777

# The one API key. `protagine init` writes it to <instance>/api.key (mode 600);
# setting it here overrides the file. Without a key the API serves loopback
# clients only.
PROTAGINE_API_KEY=

# Exact person IDs used by authenticated audience lanes. OWNER falls back to
# PROTAGINE_OWNER_CONTACT_ID below when PROTAGINE_OWNER_PERSON_ID is unset.
# PROTAGINE_OWNER_PERSON_ID=
# PROTAGINE_SHARED_PERSON_ID=shared
# PROTAGINE_GLOBAL_PERSON_ID=global
# PROTAGINE_DEV_PERSON_ID=dev-anonymous

# Where stores and config live (default ~/.protagine)
# PROTAGINE_STATE_DIR=~/.protagine

# Durable host-event journal (default <state-dir>/events). Events are written
# before live WebSocket delivery; retention is the replay window.
# PROTAGINE_EVENT_JOURNAL_DIR=~/.protagine/events
# PROTAGINE_EVENT_JOURNAL_RETENTION=500

# Per-client host-event WebSocket buffer. A slow client receives an explicit
# overflow frame and reconnects from its last processed journal sequence.
# PROTAGINE_EVENT_SUBSCRIBER_QUEUE_SIZE=256

# Contacts database filename, relative to the state dir
PROTAGINE_CONTACTS_DB=protagine-contacts.db

# The agent's authoritative timezone (temporal awareness)
# PROTAGINE_AGENT_TIMEZONE=UTC
# Owner-local timezone for quiet hours and autonomy scheduling
# PROTAGINE_TIMEZONE=UTC

LOG_LEVEL=info

# =============================================================================
# OWNER & APPROVAL
# =============================================================================

# The owner's contact id. Used by the approval gate, owner-preference
# learning, trust-engine notifications, and the delivery path.
# PROTAGINE_OWNER_CONTACT_ID=

# Approval policy for gated actions: strict (default) or graduated.
# PROTAGINE_APPROVAL_POLICY=strict

# Envelope for newly issued exact-scope approval grants. Finite defaults keep
# the historical 30-day / 100-use ceilings. TTL accepts an integer >= 60 and
# uses accepts an integer >= 1; the explicit literal "unlimited" makes that
# dimension persist until revocation. Standing authority is warned by the
# server and `protagine doctor`.
# PROTAGINE_GRANT_MAX_TTL_SECONDS=2592000
# PROTAGINE_GRANT_MAX_USES=100

# =============================================================================
# AUTONOMY
# =============================================================================
# The mind's posture lives in <instance>/protagine.yaml (mind.enabled,
# mind.autonomy: off | suggest | standard | trusted, mind.deny, mind.faculties).
# PROTAGINE_MIND_ENABLED and PROTAGINE_AUTONOMY override it for one process.
# GET /v1/host/autonomy/posture returns the RESOLVED switches of the running
# process.

# --- Per-subsystem switches ------------------------------------------------

# In-process initiative executor (reasons about initiatives with the agent's
# own LLM + tools): true / false
# PROTAGINE_EXECUTOR_ENABLED=true
# PROTAGINE_EXECUTOR_MODEL_TIER=small          # small / medium / large
# PROTAGINE_EXECUTOR_TYPES=                    # csv of initiative types to handle
# PROTAGINE_EXECUTOR_CYCLE_SECS=30
# PROTAGINE_EXECUTOR_MAX_PER_CYCLE=5
# PROTAGINE_EXECUTOR_MAX_TOOL_ITERS=           # max tool rounds per initiative

# Background cognition and per-turn introspection: true / false
# PROTAGINE_COGNITION_ENABLED=true
# PROTAGINE_INTROSPECT_ENABLED=true

# Self-directed thinking (proposals from idle reflection): off / shadow / live
# PROTAGINE_THINKING_MODE=shadow
# PROTAGINE_THINKING_INTERVAL_SECS=3600
# PROTAGINE_THINKING_MAX_INITIATIVES=3

# Evidence-derived P6 situation spine: off / shadow / live. shadow is strictly
# observer-only; live composes P3 capacity and fails closed on missing context.
# PROTAGINE_SITUATION_SPINE=off
# Initial journal cursor when P6 first opens: tail (live canary) / replay.
# PROTAGINE_SITUATION_BOOTSTRAP=tail

# Skill distillation (compounding procedure memory): off / shadow / live
# PROTAGINE_SKILLS_DISTILL=shadow

# Escalation mining (spot correction/consultation turns for
# self-improvement): off / shadow / live
# PROTAGINE_ESCALATION_MINING=shadow
# Training-corpus exporter (POST /v1/host/mining/corpus/export; writes JSONL
# under the state dir only): true / false
# PROTAGINE_CORPUS_EXPORT_ENABLED=true

# =============================================================================
# CONNECTORS (senses) — read-only pull connectors
# =============================================================================
# PROTAGINE_CONNECTORS_MODE: off / shadow / live. In shadow, connectors poll and
# LOG what they would ingest, writing nothing. Each connector is then enabled
# and configured individually via PROTAGINE_CONNECTOR_<NAME>_<KEY>.
# PROTAGINE_CONNECTORS_MODE=shadow

# IMAP email (read-only; never sends)
# PROTAGINE_CONNECTOR_IMAP_ENABLED=true
# PROTAGINE_CONNECTOR_IMAP_HOST=imap.example.com
# PROTAGINE_CONNECTOR_IMAP_PORT=993
# PROTAGINE_CONNECTOR_IMAP_USER=
# PROTAGINE_CONNECTOR_IMAP_PASSWORD=
# PROTAGINE_CONNECTOR_IMAP_MAILBOX=INBOX
# PROTAGINE_CONNECTOR_IMAP_MAX=20
# PROTAGINE_CONNECTOR_IMAP_POLL_SECS=900

# Calendar via ICS URL (read-only)
# PROTAGINE_CONNECTOR_CALENDAR_ENABLED=true
# PROTAGINE_CONNECTOR_CALENDAR_ICS_URL=https://example.com/calendar.ics
# PROTAGINE_CONNECTOR_CALENDAR_USER=
# PROTAGINE_CONNECTOR_CALENDAR_PASSWORD=
# PROTAGINE_CONNECTOR_CALENDAR_POLL_SECS=1800

# Filesystem documents (watch a folder)
# PROTAGINE_CONNECTOR_FS_ENABLED=true
# PROTAGINE_CONNECTOR_FS_PATH=~/Documents/inbox
# PROTAGINE_CONNECTOR_FS_EXTENSIONS=txt,md,pdf,docx
# PROTAGINE_CONNECTOR_FS_POLL_SECS=600

# Generic webhook pull (poll a JSON endpoint)
# PROTAGINE_CONNECTOR_WEBHOOK_ENABLED=true
# PROTAGINE_CONNECTOR_WEBHOOK_URL=
# PROTAGINE_CONNECTOR_WEBHOOK_AUTH_HEADER=
# PROTAGINE_CONNECTOR_WEBHOOK_AUTH_VALUE=
# PROTAGINE_CONNECTOR_WEBHOOK_FIELD_MAP={}
# PROTAGINE_CONNECTOR_WEBHOOK_POLL_SECS=3600

# =============================================================================
# MEMORY PROVIDER — the standalone protagine-memory plugin
# =============================================================================
# The standalone protagine-memory provider does not expose queue mutation tools
# unless explicitly opted in. When the general Protagine plugin is active it is
# always reduced to its non-duplicating read/context surface.
# PROTAGINE_MEMORY_WORKER_TOOLS=0
# Governed Hermes coexistence latches. Set these exact values together only
# when the general plugin is the canonical turn writer.
# PROTAGINE_GENERAL_PLUGIN_ACTIVE=1
# PROTAGINE_MEMORY_TURN_WRITER=disabled
# The general plugin resolves this credential placeholder in Hermes config;
# leave it unset when no action mediator is deployed.
# PROTAGINE_ACTION_MEDIATOR_API_KEY=
# Optional absolute durable-outbox override (default ~/.hermes/state/...).
# PROTAGINE_HERMES_TURN_OUTBOX=
# Standalone provider identity/capabilities are operator configuration, never
# model arguments. The provider always strips the WorkOrder protocol route.
# PROTAGINE_MEMORY_WORKER_NODE_ID=protagine-memory-worker
# PROTAGINE_MEMORY_WORKER_CAPABILITIES=agent_action
# Shared-provider privacy is mandatory and cannot be disabled. Query, session,
# sender, channel, and resolved-contact bindings prevent cross-turn cache use.
# Only an explicitly attested CLI/system owner lane may use the default; set
# PROTAGINE_MCP_CONTACT_ID to the exact owner contact, never a generic "default".
# PROTAGINE_PREFETCH_QUERY_CHECK=1
# PROTAGINE_PREFETCH_TURN_CONTACT=1
# PROTAGINE_MEMORY_DEFAULT_CONTEXT_AUTHORITY=none
# PROTAGINE_MCP_CONTACT_ID=replace-with-exact-owner-contact-id
# A guest's context is always contact-scoped: their own sources, the
# commitments their sources prove shared, and their digest.

# =============================================================================
# SANDBOX — gated Docker exploration sandbox
# =============================================================================
# off / dry_run / live. Live runs scripts in a locked-down container
# (--network none, no credentials, read-only rootfs, capped resources) behind
# boundary checks and approval tiering. Never enabled live by a preset.
# PROTAGINE_SANDBOX_MODE=off
# PROTAGINE_SANDBOX_IMAGE=python:3.12-slim
# PROTAGINE_SANDBOX_CPUS=1.0
# PROTAGINE_SANDBOX_MEMORY=512m
# PROTAGINE_SANDBOX_TIMEOUT=30
# PROTAGINE_SANDBOX_PIDS=128
# PROTAGINE_SANDBOX_EGRESS=none                # keep "none" unless you know why
# PROTAGINE_SANDBOX_MAX_ARTIFACT_BYTES=1048576

# =============================================================================
# TRUST ENGINE — earned, graduated autonomy
# =============================================================================
# Per action class: shadow -> ask_first -> act_first, driven by the real
# journaled track record. Defaults are sane; override with care.
# PROTAGINE_TRUST_AUTOGRADUATE=true            # false = stages never auto-promote
# PROTAGINE_TRUST_ACT_THRESHOLD=0.8            # confidence needed to act
# PROTAGINE_TRUST_ASK_MIN_N=3                  # clean shadow runs to reach ask_first
# PROTAGINE_TRUST_ACT_MIN_N=5                  # real outcomes to reach act_first
# PROTAGINE_TRUST_BREAKER_FAILURES=3           # failures in window -> demote
# PROTAGINE_TRUST_BREAKER_WINDOW_HOURS=24

# =============================================================================
# DELIVERY & HOME CHANNEL
# =============================================================================
# Where proactive initiatives are delivered. Set at least one home channel
# (<PLATFORM>_HOME_CHANNEL) or initiatives will queue but never deliver:
# TELEGRAM_HOME_CHANNEL=
# WHATSAPP_HOME_CHANNEL=
# DISCORD_HOME_CHANNEL=
# SLACK_HOME_CHANNEL=
# SIGNAL_HOME_CHANNEL=

# Transport for reach-out delivery:
#   hermes_webhook (default) — POST the structured initiative to a composing
#                              agent's webhook, which writes the final message
#   gateway                  — POST sanitised text to a message gateway that
#                              speaks the flat {platform, chat_id, message}
#                              contract
# PROTAGINE_DELIVERY_TRANSPORT=hermes_webhook

# =============================================================================
# MODELS & SEARCH
# =============================================================================

# HuggingFace token for faster model downloads (optional)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxx

# Embedding + reranker — auto-detected by protagine init.
# Override here for API embeddings or a custom model.
PROTAGINE_EMBED_PROVIDER=
PROTAGINE_EMBED_MODEL=
PROTAGINE_EMBED_DIMS=
PROTAGINE_RERANKER_MODEL=

# Multimodal embeddings (enable with `protagine activate-multimodal`)
PROTAGINE_MULTIMODAL=false

# Web search for the research pipeline. Unset = keyless DuckDuckGo fallback.
# PROTAGINE_SEARCH_PROVIDER=tavily             # tavily / brave / serpapi
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPAPI_KEY=

# =============================================================================
# INITIATIVE ENGINE THRESHOLDS
# =============================================================================
# How sensitive proactive initiative generation is.

# Days of no contact before generating a relationship initiative (default: 7)
# PROTAGINE_INITIATIVE_CONTACT_NEGLECT_DAYS=7

# Days a goal must be blocked before generating a follow-up (default: 1)
# PROTAGINE_INITIATIVE_GOAL_BLOCK_DAYS=1

# Health score threshold — below this generates an alert (default: 70.0)
# PROTAGINE_INITIATIVE_HEALTH_THRESHOLD=70.0

# Minimum calendar gap (hours) to count as opportunity (default: 2.0)
# PROTAGINE_INITIATIVE_GAP_THRESHOLD=2.0

# Research task age (days) before generating an initiative (default: 1)
# PROTAGINE_INITIATIVE_RESEARCH_AGE_DAYS=1

# Signal accumulation threshold before generating an initiative (default: 10)
# PROTAGINE_INITIATIVE_SIGNAL_THRESHOLD=10

# ── Relationship intelligence (docs/RELATIONSHIPS.md) ────────────────────────
# Unknown senders become shadow contacts so history accrues from first
# contact (default: true)
# PROTAGINE_IDENTITY_SHADOW_CONTACTS=true

# Channel prefixes whose senderless turns attribute to the machine sentinel
# instead of a person (default: cron,api,internal)
# PROTAGINE_IDENTITY_MACHINE_CHANNELS=cron,api,internal

# --- Selfhood benchmark (Mind M0a) ---
# Weekly self-improvement metrics derived from journals (never self-reported).
# PROTAGINE_BENCHMARK_ENABLED=true
# Deliver the weekly scorecard to the owner as a proposal.
# PROTAGINE_BENCHMARK_REPORT=true
# Recall probes per weekly compute (high-confidence facts re-queried).
# PROTAGINE_BENCHMARK_PROBES=8

# off | shadow | live (default off): how the benchmark derives its weekly
# evidence (the P4 evidence rules; the experiment framework is gone).
# PROTAGINE_COGNITION_P4_MODE=off

# --- Cognitive workspace (Mind M2): continuity of thought ---
# off | shadow | live. shadow: concerns accrue, decay, and get thought about
# (journaled), no side effects. live: a thought may surface an initiative to
# the owner or propose a self-experiment.
# PROTAGINE_WORKSPACE=off
# Max concerns held on her mind (lowest-salience evicted past this).
# PROTAGINE_WORKSPACE_CAPACITY=24
# Salience half-life in hours (time decay).
# PROTAGINE_WORKSPACE_HALFLIFE_HOURS=12
# Thoughts a single concern may receive before it rests.
# PROTAGINE_WORKSPACE_THOUGHT_BUDGET=8
# Nightly window (process local time) for the heavy standing agenda; empty
# disables. Wrap-around allowed (22:00-06:00). During it she thinks more.
# PROTAGINE_SLEEP_WINDOW=

# --- Expectation engine (Mind M3a): predictions + surprise + calibration ---
# off | shadow | live. Forms predictions (e.g. a commitment gets done by its
# due date) and resolves them at their horizon; a miss becomes a surprise on
# her mind and feeds a per-domain calibration (Brier) score into the
# benchmark as calibration.<domain>.
# PROTAGINE_EXPECTATIONS=off

# ---------------------------------------------------------------------------
# Enforcement modes
# ---------------------------------------------------------------------------
# These control whether a subsystem ENFORCES or merely EVALUATES. Every one of
# them ships in a non-enforcing posture. Leaving them unset is a valid choice,
# but be clear about what it means: decisions are recorded, not applied. Audit
# rows showing a verdict are evidence that a check RAN, not that it ACTED.
# See "Operational posture" in README.md for the full table.
#
# Approval decisions. In shadow, an authorization deficit is recorded as
# shadow_compat evidence and the action proceeds anyway.
# PROTAGINE_APPROVAL_AUTHORITY_MODE=shadow
#
# Cross-encoder reranking of recall results. off | shadow | on.
# In shadow the reranker runs and logs the rank delta, then returns the
# original ANN order unchanged, so you can measure whether it helps before
# paying its latency.
# PROTAGINE_RECALL_RERANK=off
